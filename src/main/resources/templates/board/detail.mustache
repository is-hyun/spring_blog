{{> layout/header}}

<div class="container p-5">


    {{#isOwner}}
        <div class="d-flex justify-content-end">
            <a href="/board/{{board.id}}/update" class="btn btn-warning me-1">수정</a>
            <form action="/board/{{board.id}}/delete" method="post">
                <button class="btn btn-danger">삭제</button>
            </form>
        </div>
    {{/isOwner}}

    <div class="d-flex justify-content-end">
        <b>작성자</b> : {{board.username}}
    </div>

    <div>
        <h2>
            <b>{{board.title}}</b>
            {{#board.premium}}<span class="badge bg-warning text-dark">유료</span>{{/board.premium}}
        </h2>
        <hr>

        {{! canRead : 무료글이거나, 작성자이거나, 구매한 사용자 (서비스에서 계산) }}
        {{#board.canRead}}
            <div class="m-4 p-2">
                {{board.content}}
            </div>
        {{/board.canRead}}

        {{^board.canRead}}
            <div class="m-4 p-4 text-center border rounded bg-light">
                <p class="text-muted mb-3">유료 게시글입니다. 구매 후 전체 내용을 볼 수 있습니다. ({{board.price}} 포인트)</p>
                {{#sessionUserDto}}
                    <form action="/board/{{board.id}}/purchase" method="post"
                          onsubmit="return confirm('{{board.price}} 포인트로 이 게시글을 구매하시겠습니까?')">
                        <button type="submit" class="btn btn-primary">구매하기 ({{board.price}}P)</button>
                    </form>
                {{/sessionUserDto}}
                {{^sessionUserDto}}
                    <a href="/login" class="btn btn-outline-primary">로그인 후 구매</a>
                {{/sessionUserDto}}
            </div>
        {{/board.canRead}}
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <form action="/reply/save" method="post">
                <input type="hidden" name="boardId" value="{{board.id}}">
                <textarea class="form-control" rows="2" name="comment" placeholder="댓글을 입력하세요"></textarea>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary mt-1">댓글 등록</button>
                </div>
            </form>
        </div>
        <div class="card-footer"><b>댓글 목록</b></div>
        <div class="list-group">
            {{#replyList}}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex">
                        <div class="px-1 me-1 bg-primary text-white rounded">{{username}}</div>
                        <div>{{comment}}</div>
                    </div>
                    {{#isOwner}}
                        <form action="/reply/{{id}}/delete" method="post">
                            <input type="hidden" name="boardId" value="{{board.id}}">
                            <button class="btn"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    {{/isOwner}}
                </div>
            {{/replyList}}
        </div>
    </div>
</div>

{{> layout/footer}}