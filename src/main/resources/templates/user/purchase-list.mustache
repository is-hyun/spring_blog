{{> layout/header}}

<div class="container p-5" style="max-width: 800px;">
    <!-- 카드 상단 헤더 -->
    <div class="card">
        <div class="card-header"><h4 class="mb-0"><b>구매 내역</b></h4></div>

        <!-- 최소 높이를 유지하여 내역이 없거나 적어도 카드가 찌그러지지 않게 방어 -->
        <div class="card-body p-4" style="min-height: 320px;">

            <!-- 1. 구매 내역 목록 출력 (데이터가 존재하는 경우) -->
            {{#purchaseList}}
                <div class="card mb-3 shadow-sm border-light position-relative">
                    <div class="card-body d-flex justify-content-between align-items-center py-3">
                        <div>
                            <!-- 게시글 제목 -->
                            <h5 class="card-title text-primary fw-semibold mb-2 pr-5">{{boardTitle}}</h5>
                            <!-- 작성자 및 구매일 정보 (폰트어썸 아이콘 적용) -->
                            <p class="card-text text-muted mb-1 fs-6">
                                <i class="fa-solid fa-user me-2"></i>작성자: {{boardWriter}}
                            </p>
                            <p class="card-text text-muted mb-0 fs-6">
                                <i class="fa-solid fa-calendar-days me-2"></i>구매일: {{createdAt}}
                            </p>
                        </div>

                        <!-- 포인트 뱃지 우상단 고정 -->
                        <div class="position-absolute" style="top: 15px; right: 15px;">
                            <span class="badge bg-primary fs-6 px-3 py-2">-{{price}} P</span>
                        </div>
                    </div>
                </div>
            {{/purchaseList}}

            <!-- 2. 구매 내역이 없는 경우 -->
            {{^purchaseList}}
                <!-- pt-5 클래스로 안내 문구를 아래로 이동 -->
                <div class="text-center pt-5 pb-3">
                    <div class="mb-3 text-secondary">
                        <i class="fa-solid fa-cart-shopping" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="text-secondary fw-bold mb-2">구매 내역이 없습니다</h4>
                    <p class="text-muted mb-4 fs-6">유료 게시글을 구매해보세요!</p>
                    <a href="/board/list" class="btn btn-primary px-4 py-2 fw-bold">게시글 목록으로</a>
                </div>
            {{/purchaseList}}
        </div>

        <!-- 하단 돌아가기 버튼 영역 (안정적인 좌우/하단 여백 확보) -->
        <div class="px-4 mb-4 text-start">
            <a href="/user/detail" class="btn btn-secondary px-4 py-2 fw-semibold">회원정보로 돌아가기</a>
        </div>
    </div>

</div>

{{> layout/footer}}
